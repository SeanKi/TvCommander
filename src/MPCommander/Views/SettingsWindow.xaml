<Window x:Class="MPCommander.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="설정" Width="600" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" FontFamily="Segoe UI" FontSize="12">
    <Window.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Width" Value="130"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="DockPanel">
            <Setter Property="Margin" Value="0,3"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </Window.Resources>
    <StackPanel Margin="14">
        <GroupBox Header="언어 / Language">
            <StackPanel>
                <DockPanel>
                    <TextBlock Text="화면 언어" Style="{StaticResource Label}"/>
                    <ComboBox x:Name="LangCombo" Width="220" HorizontalAlignment="Left"/>
                </DockPanel>
                <TextBlock Foreground="Gray" TextWrapping="Wrap" Margin="0,2,0,2"
                           Text="언어 팩은 프로그램 폴더의 lang\*.txt 입니다. 바꾸면 다시 시작할 때 적용됩니다."/>
            </StackPanel>
        </GroupBox>

        <GroupBox Header="백업 후 복사 (Backup-Copy, Ctrl+B)">
            <StackPanel>
                <DockPanel>
                    <TextBlock Text="백업 위치" Style="{StaticResource Label}"/>
                    <TextBox x:Name="BackupRootBox" Padding="3,2" ToolTip="상대 경로면 대상 폴더 아래 (기본: backup). 절대 경로도 됩니다"/>
                </DockPanel>
                <DockPanel>
                    <TextBlock Text="폴더 이름 앞말" Style="{StaticResource Label}"/>
                    <TextBox x:Name="BackupPrefixBox" Width="160" HorizontalAlignment="Left" Padding="3,2" ToolTip="예: v2_ → v2_20261009_0947"/>
                </DockPanel>
                <CheckBox x:Name="BackupRestartCheck" Content="복사가 끝나면 닫았던 프로그램을 다시 실행" Margin="0,4,0,2"/>
            </StackPanel>
        </GroupBox>

        <GroupBox Header="압축 / 압축 풀기">
            <StackPanel>
                <DockPanel>
                    <TextBlock Text="압축 형식" Style="{StaticResource Label}"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <RadioButton x:Name="Pack7z" Content="7z" GroupName="PackFormat" Margin="0,0,18,0"/>
                        <RadioButton x:Name="PackZip" Content="ZIP" GroupName="PackFormat"/>
                    </StackPanel>
                </DockPanel>
                <DockPanel>
                    <TextBlock Text="압축 수준" Style="{StaticResource Label}"/>
                    <ComboBox x:Name="PackLevelCombo" Width="160" HorizontalAlignment="Left">
                        <ComboBoxItem Content="저장 (압축 안 함)"/>
                        <ComboBoxItem Content="빠르게"/>
                        <ComboBoxItem Content="보통"/>
                        <ComboBoxItem Content="최고"/>
                    </ComboBox>
                </DockPanel>
                <CheckBox x:Name="PackContentsCheck" Content="폴더 하나를 압축할 때 최상위 폴더 제외 (안의 내용만)" Margin="0,4,0,2"/>
                <CheckBox x:Name="UnpackFolderCheck" Content="압축 풀 때 압축 파일마다 그 이름의 폴더 만들기" Margin="0,2"/>
                <CheckBox x:Name="UnpackOverwriteCheck" Content="압축 풀 때 같은 이름의 파일 덮어쓰기 (끄면 건너뛰기)" Margin="0,2"/>
            </StackPanel>
        </GroupBox>

        <GroupBox Header="차단 해제 (Ctrl+Shift+U)">
            <StackPanel>
                <CheckBox x:Name="UnblockRecursiveCheck" Content="하위 폴더까지" Margin="0,2"/>
                <DockPanel>
                    <TextBlock Text="파일 형식" Style="{StaticResource Label}"/>
                    <TextBox x:Name="UnblockTypesBox" Padding="3,2" ToolTip="; 로 구분, 점 없이 (예: exe;dll;msi)"/>
                </DockPanel>
                <CheckBox x:Name="UnblockAllCheck" Content="모든 파일 (형식 무시)" Margin="0,2"/>
            </StackPanel>
        </GroupBox>

        <GroupBox Header="프로그램">
            <StackPanel>
                <DockPanel>
                    <TextBlock Text="편집기 (F4)" Style="{StaticResource Label}"/>
                    <TextBox x:Name="EditorBox" Padding="3,2" ToolTip="비워 두면 내장 편집기 (CSV 는 표 편집기). 외부 편집기를 쓰려면 적으세요 — 예: code, C:\Program Files\Notepad++\notepad++.exe&#x0a;Shift+F4 는 늘 외부 편집기 (비어 있으면 메모장)"/>
                </DockPanel>
                <DockPanel>
                    <TextBlock Text="터미널 (F9)" Style="{StaticResource Label}"/>
                    <TextBox x:Name="TerminalBox" Padding="3,2" ToolTip="auto = Windows Terminal 이 있으면 wt, 없으면 cmd. 또는 실행 파일 (cmd, powershell, wt ...)"/>
                </DockPanel>
            </StackPanel>
        </GroupBox>

        <TextBlock Foreground="Gray" TextWrapping="Wrap" Text="설정 파일: %APPDATA%\MP-Commander\settings.ini"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="확인" IsDefault="True" Style="{StaticResource DialogButton}" Click="Ok_Click"/>
            <Button Content="취소" IsCancel="True" Style="{StaticResource DialogButton}"/>
        </StackPanel>
    </StackPanel>
</Window>
