<Window x:Class="MPCommander.Views.ConnectionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="원격 연결 관리 (FTP / WebDAV)" Width="720" Height="420" MinWidth="520" MinHeight="260"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner" FontFamily="Segoe UI" FontSize="12">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Right" Margin="10,0,0,0">
            <StackPanel.Resources>
                <Style TargetType="Button" BasedOn="{StaticResource DialogButton}">
                    <Setter Property="Margin" Value="0,0,0,6"/>
                    <Setter Property="MinWidth" Value="96"/>
                </Style>
            </StackPanel.Resources>
            <Button x:Name="ConnectButton" Content="연결" FontWeight="SemiBold" Click="Connect_Click" ToolTip="활성 패널에서 엽니다 (Enter / 더블클릭)"/>
            <Separator Margin="0,2,0,8"/>
            <Button Content="추가..." Click="Add_Click"/>
            <Button x:Name="EditButton" Content="편집..." Click="Edit_Click"/>
            <Button x:Name="DeleteButton" Content="삭제" Click="Delete_Click"/>
            <Separator Margin="0,2,0,8"/>
            <Button Content="닫기" IsCancel="True" Click="Close_Click"/>
        </StackPanel>
        <TextBlock DockPanel.Dock="Bottom" Margin="0,8,0,0" Foreground="Gray" TextWrapping="Wrap"
                   Text="연결은 드라이브 목록에도 🌐 로 나옵니다. 비밀번호는 Windows 사용자 계정으로 암호화해 저장합니다."/>
        <ListView x:Name="List" SelectionMode="Single" MouseDoubleClick="List_MouseDoubleClick" KeyDown="List_KeyDown"
                  SelectionChanged="List_SelectionChanged">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="이름" Width="140" DisplayMemberBinding="{Binding Name}"/>
                    <GridViewColumn Header="종류" Width="70" DisplayMemberBinding="{Binding KindText}"/>
                    <GridViewColumn Header="주소" Width="260" DisplayMemberBinding="{Binding AddressText}"/>
                    <GridViewColumn Header="사용자" Width="100" DisplayMemberBinding="{Binding User}"/>
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</Window>
