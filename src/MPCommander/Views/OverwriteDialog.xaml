<Window x:Class="MPCommander.Views.OverwriteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="파일이 이미 있습니다" Width="600" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" FontFamily="Segoe UI" FontSize="12">
    <StackPanel Margin="14">
        <TextBlock Text="대상 위치에 같은 이름의 파일이 있습니다." FontWeight="SemiBold"/>
        <TextBlock Text="대상 (덮어쓸 파일)" Margin="0,10,0,0" Foreground="Gray"/>
        <TextBlock x:Name="DstText" TextWrapping="Wrap"/>
        <TextBlock Text="원본" Margin="0,8,0,0" Foreground="Gray"/>
        <TextBlock x:Name="SrcText" TextWrapping="Wrap"/>
        <WrapPanel Margin="0,14,0,0" HorizontalAlignment="Right">
            <WrapPanel.Resources>
                <Style TargetType="Button" BasedOn="{StaticResource DialogButton}">
                    <Setter Property="Margin" Value="6,4,0,0"/>
                </Style>
            </WrapPanel.Resources>
            <Button Content="덮어쓰기" Tag="Overwrite" IsDefault="True" Click="Choice_Click"/>
            <Button Content="모두 덮어쓰기" Tag="OverwriteAll" Click="Choice_Click"/>
            <Button Content="더 새것만 덮어쓰기" Tag="OverwriteOlderAll" Click="Choice_Click"/>
            <Button Content="건너뛰기" Tag="Skip" Click="Choice_Click"/>
            <Button Content="모두 건너뛰기" Tag="SkipAll" Click="Choice_Click"/>
            <Button Content="취소" Tag="Cancel" IsCancel="True" Click="Choice_Click"/>
        </WrapPanel>
    </StackPanel>
</Window>
