<Window x:Class="MPCommander.Views.PackDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="압축" Width="600" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" FontFamily="Segoe UI" FontSize="12">
    <StackPanel Margin="14">
        <TextBlock Text="압축할 항목" FontWeight="SemiBold"/>
        <TextBlock x:Name="SourceText" TextWrapping="Wrap" Margin="0,2,0,10"/>

        <TextBlock Text="압축 파일 (기본: 대상 패널 폴더)" FontWeight="SemiBold"/>
        <TextBox x:Name="PathBox" Margin="0,4,0,10" Padding="3,2"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <TextBlock Text="형식" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <RadioButton x:Name="Format7z" Content="7z" GroupName="Format" Margin="0,0,18,0" Checked="Format_Checked"/>
                <RadioButton x:Name="FormatZip" Content="ZIP" GroupName="Format" Checked="Format_Checked"/>
            </StackPanel>
            <TextBlock Grid.Row="1" Text="압축 수준" VerticalAlignment="Center" Margin="0,8,12,0"/>
            <ComboBox x:Name="LevelCombo" Grid.Row="1" Grid.Column="1" Width="160" HorizontalAlignment="Left" Margin="0,8,0,0">
                <ComboBoxItem Content="저장 (압축 안 함)"/>
                <ComboBoxItem Content="빠르게"/>
                <ComboBoxItem Content="보통"/>
                <ComboBoxItem Content="최고"/>
            </ComboBox>
        </Grid>

        <CheckBox x:Name="ContentsOnlyCheck" Margin="0,10,0,0" Visibility="Collapsed"
                  Content="최상위 폴더 제외 — 안의 내용만 압축"
                  ToolTip="고른 폴더 자체는 넣지 않고 그 안의 파일·폴더만 압축합니다. 압축을 풀면 폴더 없이 내용이 바로 나옵니다."/>

        <TextBlock x:Name="SevenZipText" Foreground="Gray" TextWrapping="Wrap" Margin="0,10,0,0"/>
        <TextBlock x:Name="ErrorText" Foreground="Firebrick" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="압축" IsDefault="True" Style="{StaticResource DialogButton}" Click="Ok_Click"/>
            <Button Content="취소" IsCancel="True" Style="{StaticResource DialogButton}"/>
        </StackPanel>
    </StackPanel>
</Window>
