<Window x:Class="MPCommander.Views.SearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="파일 찾기" Width="960" Height="640" MinWidth="560" MinHeight="360"
        WindowStartupLocation="CenterOwner" FontFamily="Segoe UI" FontSize="12">
    <DockPanel Margin="10">
        <Grid DockPanel.Dock="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="시작 폴더" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox x:Name="RootBox" Grid.Column="1" Padding="3,2" Margin="0,2"/>
            <TextBlock Grid.Row="1" Text="파일 이름" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox x:Name="MaskBox" Grid.Row="1" Grid.Column="1" Padding="3,2" Margin="0,2" Text="*"
                     ToolTip="예: *.txt;*.log   와일드카드(* ?)가 없으면 이름에 포함된 것을 찾습니다"/>
            <TextBlock Grid.Row="2" Text="포함 텍스트" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox x:Name="ContentBox" Grid.Row="2" Grid.Column="1" Padding="3,2" Margin="0,2"
                     ToolTip="파일 내용에서 찾을 문자열 (UTF-8 / UTF-16 / CP949)"/>
            <StackPanel Grid.Column="2" Grid.RowSpan="3" Margin="10,2,0,2">
                <Button x:Name="StartButton" Content="찾기" IsDefault="True" Style="{StaticResource DialogButton}" Margin="0,0,0,4" Click="Start_Click"/>
                <Button Content="닫기" Style="{StaticResource DialogButton}" Margin="0" Click="Close_Click"/>
            </StackPanel>
        </Grid>

        <WrapPanel DockPanel.Dock="Top" Margin="0,6,0,6">
            <CheckBox x:Name="RecursiveCheck" Content="하위 폴더 포함" IsChecked="True" Margin="0,0,16,0"/>
            <CheckBox x:Name="CaseCheck" Content="대소문자 구분 (내용)" Margin="0,0,16,0"/>
            <CheckBox x:Name="HiddenCheck" Content="숨김 파일 포함" Margin="0,0,16,0"/>
        </WrapPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
            <Button DockPanel.Dock="Right" Content="패널에서 보기" Style="{StaticResource DialogButton}" Click="GoTo_Click"
                    ToolTip="선택한 파일이 있는 폴더를 활성 패널에서 엽니다 (Enter / 더블클릭)"/>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </DockPanel>

        <ListView x:Name="ResultList" FontSize="{DynamicResource ListFontSize}" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                  MouseDoubleClick="ResultList_MouseDoubleClick" KeyDown="ResultList_KeyDown">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="이름" Width="240" DisplayMemberBinding="{Binding Name}"/>
                    <GridViewColumn Header="폴더" Width="420" DisplayMemberBinding="{Binding Folder}"/>
                    <GridViewColumn Header="크기" Width="96">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding SizeText}" TextAlignment="Right"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="날짜" Width="120" DisplayMemberBinding="{Binding DateText}"/>
                </GridView>
            </ListView.View>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                </Style>
            </ListView.ItemContainerStyle>
        </ListView>
    </DockPanel>
</Window>
