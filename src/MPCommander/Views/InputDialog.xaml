<Window x:Class="MPCommander.Views.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="560" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" FontFamily="Segoe UI" FontSize="12">
    <StackPanel Margin="14">
        <TextBlock x:Name="PromptText" TextWrapping="Wrap"/>
        <TextBox x:Name="InputBox" Margin="0,6,0,0" Padding="3,2"/>
        <DockPanel Margin="0,14,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Right" Content="취소" IsCancel="True" Style="{StaticResource DialogButton}"/>
            <Button DockPanel.Dock="Right" Content="확인" IsDefault="True" Style="{StaticResource DialogButton}" Click="Ok_Click"/>
            <!-- 선택 사항 (예: 복사의 FastCopy 모드). 쓰지 않으면 숨김 -->
            <CheckBox x:Name="OptionCheck" DockPanel.Dock="Left" VerticalAlignment="Center" Visibility="Collapsed"/>
        </DockPanel>
    </StackPanel>
</Window>
