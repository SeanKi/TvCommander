<Window x:Class="MPCommander.Views.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="560" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" FontFamily="Segoe UI" FontSize="12">
    <StackPanel Margin="14">
        <TextBlock x:Name="PromptText" TextWrapping="Wrap"/>
        <TextBox x:Name="InputBox" Margin="0,6,0,0" Padding="3,2"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="확인" IsDefault="True" Style="{StaticResource DialogButton}" Click="Ok_Click"/>
            <Button Content="취소" IsCancel="True" Style="{StaticResource DialogButton}"/>
        </StackPanel>
    </StackPanel>
</Window>
