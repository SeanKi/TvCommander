<Window x:Class="MPCommander.Views.UnblockDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="차단 해제" Width="560" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" FontFamily="Segoe UI" FontSize="12">
    <StackPanel Margin="14">
        <TextBlock TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,8"
                   Text="인터넷에서 받은 파일에 붙는 '차단' 표시(Mark of the Web)를 지웁니다. 실행할 때 나오는 보안 경고와 '이 파일은 다른 컴퓨터에서 왔으므로…' 차단이 사라집니다."/>
        <TextBlock Text="대상" FontWeight="SemiBold"/>
        <TextBlock x:Name="TargetText" TextWrapping="Wrap" Margin="0,2,0,10"/>

        <CheckBox x:Name="RecursiveCheck" Content="하위 폴더까지 (recursive)" Margin="0,0,0,8"/>

        <GroupBox Header="폴더 안에서 차단 해제할 파일 형식" Padding="8,6">
            <StackPanel>
                <CheckBox x:Name="AllFilesCheck" Content="모든 파일" Margin="0,0,0,6" Checked="AllFiles_Changed" Unchecked="AllFiles_Changed"/>
                <WrapPanel x:Name="TypePanel">
                    <WrapPanel.Resources>
                        <Style TargetType="CheckBox">
                            <Setter Property="Width" Value="70"/>
                            <Setter Property="Margin" Value="0,2"/>
                        </Style>
                    </WrapPanel.Resources>
                </WrapPanel>
                <DockPanel Margin="0,6,0,0">
                    <TextBlock Text="기타 형식" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox x:Name="OtherTypesBox" Padding="3,2" ToolTip="예: jar;py;reg  (; 로 구분, 점 없이)"/>
                </DockPanel>
                <TextBlock Foreground="Gray" Margin="0,6,0,0" TextWrapping="Wrap"
                           Text="직접 고른 파일은 형식과 관계없이 차단 해제합니다. 형식은 폴더 안의 파일에만 적용됩니다."/>
            </StackPanel>
        </GroupBox>

        <TextBlock x:Name="ErrorText" Foreground="Firebrick" Margin="0,8,0,0" Visibility="Collapsed"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="차단 해제" IsDefault="True" Style="{StaticResource DialogButton}" Click="Ok_Click"/>
            <Button Content="취소" IsCancel="True" Style="{StaticResource DialogButton}"/>
        </StackPanel>
    </StackPanel>
</Window>
