<Window x:Class="MPCommander.Views.UnpackDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="압축 풀기" Width="600" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" FontFamily="Segoe UI" FontSize="12">
    <StackPanel Margin="14">
        <TextBlock Text="압축 파일" FontWeight="SemiBold"/>
        <TextBlock x:Name="SourceText" TextWrapping="Wrap" Margin="0,2,0,10"/>

        <TextBlock Text="풀 위치 (기본: 대상 패널 폴더)" FontWeight="SemiBold"/>
        <TextBox x:Name="PathBox" Margin="0,4,0,10" Padding="3,2"/>

        <CheckBox x:Name="SubfolderCheck" Content="압축 파일마다 그 이름으로 폴더를 만들어 풀기" Checked="Option_Changed" Unchecked="Option_Changed"
                  ToolTip="예: 자료.7z → 풀 위치\자료\ 아래에 풉니다. 끄면 풀 위치에 바로 풉니다."/>
        <CheckBox x:Name="OverwriteCheck" Content="이미 있는 같은 이름의 파일은 덮어쓰기 (끄면 건너뛰기)" Margin="0,6,0,0"/>

        <TextBlock x:Name="PreviewText" Foreground="Gray" TextWrapping="Wrap" Margin="0,10,0,0"/>
        <TextBlock x:Name="ErrorText" Foreground="Firebrick" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="압축 풀기" IsDefault="True" Style="{StaticResource DialogButton}" Click="Ok_Click"/>
            <Button Content="취소" IsCancel="True" Style="{StaticResource DialogButton}"/>
        </StackPanel>
    </StackPanel>
</Window>
