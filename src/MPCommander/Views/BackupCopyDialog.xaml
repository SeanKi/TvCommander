<Window x:Class="MPCommander.Views.BackupCopyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="백업 후 복사 (Backup-Copy)" Width="720" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" FontFamily="Segoe UI" FontSize="12">
    <StackPanel Margin="14">
        <TextBlock TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,8"
                   Text="대상에 이미 있는 같은 이름의 파일을 먼저 백업 폴더에 복사해 둔 뒤, 고른 파일을 대상에 복사합니다. 실행 중인 프로그램이 대상 파일을 쓰고 있으면 먼저 닫아야 합니다."/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <TextBlock Text="원본" FontWeight="SemiBold" Margin="0,0,12,4"/>
            <TextBlock x:Name="SourceText" Grid.Column="1" TextWrapping="Wrap" Margin="0,0,0,4"/>
            <TextBlock Grid.Row="1" Text="대상" FontWeight="SemiBold" Margin="0,0,12,4"/>
            <TextBlock x:Name="TargetText" Grid.Row="1" Grid.Column="1" TextWrapping="Wrap" Margin="0,0,0,4"/>
            <TextBlock Grid.Row="2" Text="파일" FontWeight="SemiBold" Margin="0,0,12,4"/>
            <TextBlock x:Name="CountText" Grid.Row="2" Grid.Column="1" TextWrapping="Wrap" Margin="0,0,0,4"/>
        </Grid>

        <GroupBox Header="백업" Padding="8,6" Margin="0,8,0,0">
            <StackPanel>
                <DockPanel>
                    <TextBlock Text="백업 위치" Width="110" VerticalAlignment="Center"/>
                    <TextBox x:Name="RootBox" Padding="3,2" TextChanged="Backup_Changed"
                             ToolTip="상대 경로면 대상 폴더 아래 (기본: backup). 절대 경로도 됩니다 (예: D:\backup\myapp)"/>
                </DockPanel>
                <DockPanel Margin="0,6,0,0">
                    <TextBlock Text="폴더 이름 앞말" Width="110" VerticalAlignment="Center"/>
                    <TextBox x:Name="PrefixBox" Width="160" HorizontalAlignment="Left" Padding="3,2" TextChanged="Backup_Changed"
                             ToolTip="시각 폴더 이름 앞에 붙일 말 (선택). 예: v2_ → v2_20261009_0947"/>
                </DockPanel>
                <TextBlock x:Name="BackupPreview" Foreground="Gray" TextWrapping="Wrap" Margin="0,6,0,0"/>
            </StackPanel>
        </GroupBox>

        <GroupBox Header="대상 파일을 쓰고 있는 프로그램" Padding="8,6" Margin="0,8,0,0">
            <StackPanel>
                <TextBlock x:Name="ProcessStatus" TextWrapping="Wrap" Margin="0,0,0,6"/>
                <ListView x:Name="ProcessList" Height="110" SelectionMode="Extended">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="프로그램" Width="170" DisplayMemberBinding="{Binding Display}"/>
                            <GridViewColumn Header="PID" Width="60" DisplayMemberBinding="{Binding Pid}"/>
                            <GridViewColumn Header="실행 파일" Width="420" DisplayMemberBinding="{Binding ExePath}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Button x:Name="RecheckButton" Content="다시 확인" Padding="10,2" Click="Recheck_Click"/>
                    <Button x:Name="CloseButton" Content="닫기 요청" Padding="10,2" Margin="6,0,0,0" Click="CloseProcesses_Click"
                            ToolTip="선택한(없으면 모든) 프로그램에 창 닫기를 요청합니다. 저장 확인이 뜨면 그 프로그램에서 답하세요."/>
                    <Button x:Name="KillButton" Content="강제 종료" Padding="10,2" Margin="6,0,0,0" Click="KillProcesses_Click"
                            ToolTip="선택한(없으면 모든) 프로그램을 강제로 끝냅니다. 저장하지 않은 내용은 사라집니다."/>
                </StackPanel>
                <CheckBox x:Name="RestartCheck" Content="복사가 끝나면 닫았던 프로그램을 다시 실행" Margin="0,8,0,0"/>
            </StackPanel>
        </GroupBox>

        <TextBlock x:Name="ErrorText" Foreground="Firebrick" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="OkButton" Content="계속 (백업 후 복사)" IsDefault="True" Padding="14,3" MinWidth="80" Margin="6,0,0,0" Click="Ok_Click"/>
            <Button Content="취소" IsCancel="True" Style="{StaticResource DialogButton}"/>
        </StackPanel>
    </StackPanel>
</Window>
