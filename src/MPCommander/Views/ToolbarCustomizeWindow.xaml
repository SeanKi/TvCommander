<Window x:Class="MPCommander.Views.ToolbarCustomizeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="툴바 사용자 지정" Width="660" Height="500" MinWidth="520" MinHeight="360"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" FontFamily="Segoe UI" FontSize="12">
    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,8"
                   Text="왼쪽은 쓸 수 있는 항목, 오른쪽은 툴바에 보이는 항목입니다 (위에서부터 왼쪽 → 오른쪽 순서). 더블클릭으로도 넣고 뺄 수 있습니다. 숨긴 항목도 단축키로는 그대로 쓸 수 있습니다."/>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="기본값으로" Padding="10,2" Margin="0,0,24,0" Click="Default_Click"/>
            <Button Content="확인" IsDefault="True" Style="{StaticResource DialogButton}" Margin="0,0,6,0" Click="Ok_Click"/>
            <Button Content="취소" IsCancel="True" Style="{StaticResource DialogButton}"/>
        </StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Text="쓸 수 있는 항목" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <ListBox x:Name="AvailableList" Grid.Row="1" DisplayMemberPath="Name" SelectionMode="Extended" MouseDoubleClick="Add_Click"/>
            <StackPanel Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Margin="8,0">
                <Button Content="넣기 →" Padding="10,3" Margin="0,0,0,6" Click="Add_Click"/>
                <Button Content="← 빼기" Padding="10,3" Margin="0,0,0,18" Click="Remove_Click"/>
                <Button Content="구분선 넣기" Padding="10,3" Click="Separator_Click"/>
            </StackPanel>
            <TextBlock Grid.Column="2" Text="툴바" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <ListBox x:Name="ToolbarList" Grid.Row="1" Grid.Column="2" DisplayMemberPath="Name" SelectionMode="Extended" MouseDoubleClick="Remove_Click"/>
            <StackPanel Grid.Row="1" Grid.Column="3" VerticalAlignment="Center" Margin="8,0,0,0">
                <Button Content="▲ 위로" Padding="10,3" Margin="0,0,0,6" Click="Up_Click"/>
                <Button Content="▼ 아래로" Padding="10,3" Click="Down_Click"/>
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
