<UserControl x:Class="MPCommander.Views.FilePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border x:Name="OuterBorder" BorderThickness="2" BorderBrush="Transparent">
        <DockPanel>
            <!-- 드라이브 / 경로 -->
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,2">
                <ComboBox x:Name="DriveCombo" DockPanel.Dock="Left" Width="92" IsTabStop="False"
                          DisplayMemberPath="Display"
                          DropDownOpened="DriveCombo_DropDownOpened"
                          DropDownClosed="DriveCombo_DropDownClosed"
                          SelectionChanged="DriveCombo_SelectionChanged"/>
                <Border x:Name="TargetBadge" DockPanel.Dock="Left" Background="#FFF0A030" CornerRadius="2"
                        Margin="3,0,0,0" Padding="5,0" Visibility="Collapsed" VerticalAlignment="Stretch">
                    <TextBlock Text="대상" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </Border>
                <Button DockPanel.Dock="Right" Content="\" Width="22" Focusable="False" ToolTip="루트" Click="Root_Click"/>
                <Button x:Name="HistoryButton" DockPanel.Dock="Right" Width="24" Focusable="False" Margin="0,0,2,0"
                        ToolTip="폴더 히스토리 (Alt+↓)" Click="History_Click">
                    <TextBlock Text="&#xE81C;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center"/>
                </Button>
                <!-- 별표: 현재 폴더를 '자주 머문 폴더'에 올리기/내리기 (Ctrl+D). 목록에 있으면 노란 별 -->
                <Button x:Name="StarButton" DockPanel.Dock="Right" Width="24" Focusable="False" Margin="2,0,2,0"
                        Click="Star_Click">
                    <TextBlock x:Name="StarGlyph" Text="&#xE734;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Button>
                <Button DockPanel.Dock="Right" Content=".." Width="22" Focusable="False" ToolTip="상위 폴더" Click="Up_Click"/>
                <TextBox x:Name="PathBox" Margin="3,0" Padding="2,1" VerticalContentAlignment="Center" IsTabStop="False"
                         KeyDown="PathBox_KeyDown"/>
            </DockPanel>

            <!-- 오류 표시 (네트워크 타임아웃 등) -->
            <Border x:Name="ErrorBar" DockPanel.Dock="Top" Background="#FFFFF4CE" BorderBrush="#FFE0B850"
                    BorderThickness="1" Padding="6,3" Margin="0,0,0,2" Visibility="Collapsed">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="✕" Width="22" Focusable="False" Click="CloseError_Click"/>
                    <Button DockPanel.Dock="Right" Content="다시 시도" Padding="6,0" Margin="6,0" Focusable="False" Click="Retry_Click"/>
                    <TextBlock x:Name="ErrorText" TextWrapping="Wrap" VerticalAlignment="Center"/>
                </DockPanel>
            </Border>

            <Border DockPanel.Dock="Bottom" Padding="4,2" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
                <TextBlock x:Name="StatusText" TextTrimming="CharacterEllipsis"/>
            </Border>

            <Grid>
                <ListView x:Name="FileList" SelectionMode="Single" FontSize="{DynamicResource ListFontSize}" IsTextSearchEnabled="False" AllowDrop="True"
                          BorderThickness="1"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          VirtualizingPanel.ScrollUnit="Item"
                          PreviewKeyDown="FileList_PreviewKeyDown"
                          PreviewTextInput="FileList_PreviewTextInput"
                          PreviewMouseLeftButtonDown="FileList_PreviewMouseLeftButtonDown"
                          PreviewMouseLeftButtonUp="FileList_PreviewMouseLeftButtonUp"
                          PreviewMouseRightButtonDown="FileList_PreviewMouseRightButtonDown"
                          MouseRightButtonUp="FileList_MouseRightButtonUp"
                          PreviewMouseMove="FileList_PreviewMouseMove"
                          DragEnter="FileList_DragOver"
                          DragOver="FileList_DragOver"
                          DragLeave="FileList_DragLeave"
                          Drop="FileList_Drop">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <EventSetter Event="MouseDoubleClick" Handler="Item_DoubleClick"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMarked}" Value="True">
                                    <Setter Property="Foreground" Value="#FFD01818"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsHidden}" Value="True">
                                    <Setter Property="Opacity" Value="0.6"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.View>
                        <GridView AllowsColumnReorder="False">
                            <GridViewColumn x:Name="NameColumn" Header="이름" Width="240">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,4,0"/>
                                            <TextBlock Text="{Binding DisplayName}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn x:Name="ExtColumn" Header="확장자" Width="56" DisplayMemberBinding="{Binding Extension}"/>
                            <GridViewColumn x:Name="SizeColumn" Header="크기" Width="96">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding SizeText}" TextAlignment="Right" HorizontalAlignment="Stretch"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn x:Name="DateColumn" Header="날짜" Width="112" DisplayMemberBinding="{Binding DateText}"/>
                            <GridViewColumn x:Name="AttrColumn" Header="속성" Width="44" DisplayMemberBinding="{Binding AttrText}"/>
                        </GridView>
                    </ListView.View>
                </ListView>

                <Border x:Name="LoadingOverlay" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="#F0FFFFFF" BorderBrush="Gray" BorderThickness="1" Padding="14,8" IsHitTestVisible="False">
                    <TextBlock x:Name="LoadingText" Text="불러오는 중..."/>
                </Border>
            </Grid>
        </DockPanel>
    </Border>
</UserControl>
