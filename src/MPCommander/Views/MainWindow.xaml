<Window x:Class="MPCommander.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MP-Commander" Width="1280" Height="800" MinWidth="640" MinHeight="400"
        FontFamily="Segoe UI" FontSize="12">
    <Window.Resources>
        <Style x:Key="Glyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
        </Style>
        <Style x:Key="Icon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="2,1"/>
        </Style>
        <Style x:Key="FnButton" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Margin" Value="1"/>
            <Setter Property="Padding" Value="4,3"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Background="{Binding Background, ElementName=MainToolBarTray}">
        <!-- 검색 상자: 입력하는 대로 Everything 결과를 아래로 펼치고, Enter = 맨 위(고른) 항목을 현재 패널에서 보기 -->
        <Grid DockPanel.Dock="Right" Width="280" Margin="6,3,8,3" VerticalAlignment="Center">
            <TextBox x:Name="SearchBox" Padding="22,3,4,3" VerticalContentAlignment="Center"
                     PreviewKeyDown="SearchBox_PreviewKeyDown" TextChanged="SearchBox_TextChanged"
                     ToolTip="파일·폴더 이름 찾기 — 입력하는 대로 Everything 이 모든 드라이브에서 찾아 아래에 펼칩니다&#x0a;Enter: 맨 위(또는 ↑↓ 로 고른) 항목을 현재 패널에서 보기 — 파일은 그 폴더를 열고 커서를, 폴더는 그 안으로&#x0a;(Everything 문법: 공백 = 그리고, | = 또는, * ?, ext:pdf, folder: 등)&#x0a;Everything 이 실행 중이 아니면 Enter 는 파일 찾기 창(현재 패널 폴더)을 엽니다"/>
            <TextBlock Style="{StaticResource Glyph}" Text="&#xE721;" FontSize="12" Foreground="Gray" IsHitTestVisible="False"
                       HorizontalAlignment="Left" Margin="7,0,0,0"/>
            <TextBlock x:Name="SearchHint" Text="찾기 (Everything) — Enter: 현재 패널로" Foreground="Gray" IsHitTestVisible="False"
                       VerticalAlignment="Center" Margin="24,0,4,0" TextTrimming="CharacterEllipsis"/>
            <Popup x:Name="SearchPopup" PlacementTarget="{Binding ElementName=SearchBox}" Placement="Bottom" StaysOpen="False"
                   Width="800" Opened="SearchPopup_Opened">
                <Border BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" BorderThickness="1"
                        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">
                    <DockPanel>
                        <TextBlock x:Name="SearchPopupStatus" DockPanel.Dock="Bottom" Margin="6,3" Foreground="Gray" TextTrimming="CharacterEllipsis"/>
                        <ListView x:Name="SearchResults" MaxHeight="420" BorderThickness="0" FontSize="{DynamicResource ListFontSize}"
                                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                  PreviewKeyDown="SearchResults_PreviewKeyDown" MouseDoubleClick="SearchResults_MouseDoubleClick"
                                  GridViewColumnHeader.Click="SearchResults_HeaderClick">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="이름" Width="230">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Style="{StaticResource Glyph}" Text="{Binding Glyph}" FontSize="12" Foreground="{Binding GlyphBrush}"/>
                                                    <TextBlock Text="{Binding Name}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="폴더" Width="300" DisplayMemberBinding="{Binding Folder}"/>
                                    <GridViewColumn Header="크기" Width="90">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate><TextBlock Text="{Binding SizeText}" TextAlignment="Right"/></DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="날짜" Width="130" DisplayMemberBinding="{Binding DateText}"/>
                                </GridView>
                            </ListView.View>
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                        </ListView>
                    </DockPanel>
                </Border>
            </Popup>
        </Grid>
        <ToolBarTray x:Name="MainToolBarTray" IsLocked="True">
            <ToolBar>
                <ToolBar.Resources>
                    <Style TargetType="Button" BasedOn="{StaticResource {x:Static ToolBar.ButtonStyleKey}}">
                        <Setter Property="Focusable" Value="False"/>
                        <Setter Property="Padding" Value="5,2"/>
                    </Style>
                    <Style TargetType="RadioButton" BasedOn="{StaticResource {x:Static ToolBar.RadioButtonStyleKey}}">
                        <Setter Property="Focusable" Value="False"/>
                        <Setter Property="Padding" Value="5,3"/>
                    </Style>
                    <Style TargetType="ToggleButton" BasedOn="{StaticResource {x:Static ToolBar.ToggleButtonStyleKey}}">
                        <Setter Property="Focusable" Value="False"/>
                        <Setter Property="Padding" Value="5,2"/>
                    </Style>
                </ToolBar.Resources>

                <!-- 패널 배치: 아이콘은 코드에서 격자 모양으로 그린다 (InitToolbarIcons) -->
                <RadioButton x:Name="Layout2" GroupName="Layout" Tag="2" Click="Layout_Click" ToolTip="2창 (Ctrl+F2)"/>
                <RadioButton x:Name="Layout3" GroupName="Layout" Tag="3" Click="Layout_Click" ToolTip="3창 (Ctrl+F3)"/>
                <RadioButton x:Name="Layout4" GroupName="Layout" Tag="4" Click="Layout_Click" ToolTip="4창 2×2 (Ctrl+F4)"/>
                <RadioButton x:Name="Layout6" GroupName="Layout" Tag="6" Click="Layout_Click" ToolTip="6창 2×3 (Ctrl+F6)"/>
                <RadioButton x:Name="Layout8" GroupName="Layout" Tag="8" Click="Layout_Click" ToolTip="8창 2×4 (Ctrl+F8)"/>
                <Separator/>
                <Button Click="Back_Click" ToolTip="뒤로 (Alt+←)"><TextBlock Style="{StaticResource Icon}" Text="&#xE72B;"/></Button>
                <Button Click="Forward_Click" ToolTip="앞으로 (Alt+→)"><TextBlock Style="{StaticResource Icon}" Text="&#xE72A;"/></Button>
                <Button Click="Up_Click" ToolTip="상위 폴더 (Backspace)"><TextBlock Style="{StaticResource Icon}" Text="&#xE74A;"/></Button>
                <Button Click="Refresh_Click" ToolTip="새로고침 (Ctrl+R)"><TextBlock Style="{StaticResource Icon}" Text="&#xE72C;"/></Button>
                <Separator/>
                <Button Click="Search_Click" ToolTip="파일 찾기 (Alt+F7)"><TextBlock Style="{StaticResource Icon}" Text="&#xE721;"/></Button>
                <Button Click="Connections_Click" ToolTip="원격 연결 관리 — FTP / FTPS / WebDAV 등록·연결 (Ctrl+F)"><TextBlock Style="{StaticResource Icon}" Text="&#xE774;"/></Button>
                <Separator/>
                <Button Click="CopyPath_Click" ToolTip="현재 폴더 경로 복사"><TextBlock Style="{StaticResource Icon}" Text="&#xE8C8;"/></Button>
                <Button Click="CopyFullPaths_Click" ToolTip="선택 항목 전체 경로 복사 (Ctrl+Shift+C)"><TextBlock Style="{StaticResource Icon}" Text="&#xE71B;"/></Button>
                <Button Click="CopyNames_Click" ToolTip="선택 항목 이름 복사"><TextBlock Style="{StaticResource Icon}" Text="&#xE8AC;"/></Button>
                <Separator/>
                <Button Click="NewFolder_Click" ToolTip="새 폴더 (F7)"><TextBlock Style="{StaticResource Icon}" Text="&#xE8F4;"/></Button>
                <Button Click="Terminal_Click" ToolTip="여기서 터미널 열기 (F9)"><TextBlock Style="{StaticResource Icon}" Text="&#xE756;"/></Button>
                <Button Click="BackupCopy_Click" ToolTip="백업 후 복사 (Ctrl+B) — 대상의 같은 이름 파일을 backup\날짜_시각 에 백업한 뒤 복사.&#x0a;실행 중인 프로그램 확인·닫기, 끝나면 다시 실행 (프로그램 업데이트용)"><!-- 폴더 + 시계: 날짜·시각 폴더에 백업 -->
                    <Grid Width="20" Height="18" Margin="1,0">
                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="16" Text="&#xED25;" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,1,0,0"/>
                        <Ellipse Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                 Fill="{Binding Background, RelativeSource={RelativeSource AncestorType=ToolBar}}"/>
                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="11" FontWeight="Bold" Text="&#xE81C;" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0.5,0.5"/>
                    </Grid></Button>
                <Button Click="Pack_Click" ToolTip="압축 (Alt+F5) — 표시한 항목을 대상 패널 폴더에 7z 또는 ZIP 으로"><TextBlock Style="{StaticResource Icon}" Text="&#xE7B8;"/></Button>
                <Button Click="Unpack_Click" ToolTip="압축 풀기 (Alt+F9) — 고른 압축 파일(ZIP·7z·RAR 등, 여러 개 가능)을 대상 패널 폴더에.&#x0a;기본으로 압축 파일마다 그 이름의 폴더를 만든다"><!-- 압축 아이콘(E7B8)의 뚜껑이 열린 모양: 글꼴에 없어 직접 그린다 -->
                    <Canvas Width="16" Height="16" Margin="2,1" VerticalAlignment="Center">
                        <Path Stroke="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}" StrokeThickness="1"
                              Data="M1.5,7.5 H14.5 V15.5 H1.5 Z M4,10.5 H9 M4,12.5 H7"/>
                        <Path Stroke="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}" StrokeThickness="1"
                              Data="M1,7.5 H15.5 V4.5 H1 Z">
                            <Path.RenderTransform><RotateTransform Angle="-24" CenterX="1" CenterY="7.5"/></Path.RenderTransform>
                        </Path>
                    </Canvas>
                </Button>
                <Button Click="Unblock_Click" ToolTip="차단 해제 — 인터넷에서 받은 파일의 차단 표시 지우기 (Ctrl+Shift+U)&#x0a;표시한 파일·폴더, 없으면 현재 폴더. 하위 폴더·파일 형식은 열리는 창에서 설정"><TextBlock Style="{StaticResource Icon}" Text="&#xE785;"/></Button>
                <Button Click="Swap_Click" ToolTip="활성·대상 패널 경로 교체 (Ctrl+U)"><TextBlock Style="{StaticResource Icon}" Text="&#xE8AB;"/></Button>
                <ToggleButton x:Name="HiddenToggle" Click="Hidden_Click" ToolTip="숨김 파일 보기 (Ctrl+H)"><TextBlock Style="{StaticResource Icon}" Text="&#xE890;"/></ToggleButton>
                <Button x:Name="FontButton" Click="Font_Click" ToolTip="목록 글씨 크기 (Ctrl+= / Ctrl+-)"><TextBlock Style="{StaticResource Icon}" Text="&#xE8D2;"/></Button>
                <Button x:Name="MdSyncButton" Click="MdSync_Click" ToolTip="MDNotePad+ 동기화 모드로 열기 — 커서의 .md 파일(없으면 빈 창)을 저장소·동기화·git 이 있는 전체 모드로 (같은 폴더의 MDNotePad+.exe)"><!-- 문서 + 동기화 -->
                    <Grid Width="20" Height="18" Margin="1,0">
                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="16" Text="&#xE7C3;" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,1,0,0"/>
                        <Ellipse Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                 Fill="{Binding Background, RelativeSource={RelativeSource AncestorType=ToolBar}}"/>
                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="11" FontWeight="Bold" Text="&#xE895;" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0.5,0.5"/>
                    </Grid></Button>
                <Button Click="Manual_Click" ToolTip="사용 설명서 (F1) — 화면 언어의 설명서를, 같은 폴더에 MDNotePad+.exe 가 있으면 그것으로, 없으면 .md 에 연결된 프로그램으로 엽니다"><TextBlock Style="{StaticResource Icon}" Text="&#xE897;"/></Button>
                <Button Click="Settings_Click" ToolTip="설정 — 백업 복사, 압축, 차단 해제, 편집기·터미널"><TextBlock Style="{StaticResource Icon}" Text="&#xE713;"/></Button>
            </ToolBar>
        </ToolBarTray>
        </DockPanel>

        <UniformGrid DockPanel.Dock="Bottom" Rows="1" Margin="2,0,2,2">
            <Button Style="{StaticResource FnButton}" Tag="F3" Click="FnKey_Click" Content="F3 보기"/>
            <Button Style="{StaticResource FnButton}" Tag="F4" Click="FnKey_Click" Content="F4 편집"/>
            <Button Style="{StaticResource FnButton}" Tag="F5" Click="FnKey_Click" Content="F5 복사"/>
            <Button Style="{StaticResource FnButton}" Tag="F6" Click="FnKey_Click" Content="F6 이동"/>
            <Button Style="{StaticResource FnButton}" Tag="F7" Click="FnKey_Click" Content="F7 새 폴더"/>
            <Button Style="{StaticResource FnButton}" Tag="F8" Click="FnKey_Click" Content="F8 삭제"/>
            <Button Style="{StaticResource FnButton}" Tag="F9" Click="FnKey_Click" Content="F9 터미널"/>
            <Button Style="{StaticResource FnButton}" Tag="F10" Click="FnKey_Click" Content="F10 종료"/>
        </UniformGrid>

        <!-- 명령줄: 활성 패널 폴더에서 실행 (Enter / Shift+Enter 창 유지, Ctrl+Enter 로 파일 이름 넣기) -->
        <DockPanel DockPanel.Dock="Bottom" Margin="4,2,4,2">
            <TextBlock x:Name="CommandPrompt" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,6,0"
                       FontFamily="Consolas, Malgun Gothic" FontSize="{DynamicResource ListFontSize}"/>
            <ComboBox x:Name="CommandBox" IsEditable="True" IsTextSearchEnabled="False" StaysOpenOnEdit="True"
                      FontFamily="Consolas, Malgun Gothic" FontSize="{DynamicResource ListFontSize}"
                      PreviewKeyDown="CommandBox_PreviewKeyDown"
                      ToolTip="명령줄 (Ctrl+E) — Enter: 실행, Shift+Enter: 창 유지, Esc: 지우기, ↑↓: 이전 명령&#x0a;cd 경로 / 드라이브(D:) 는 패널을 이동합니다&#x0a;목록에서 Ctrl+Enter: 파일 이름, Ctrl+Shift+Enter: 전체 경로, Ctrl+P: 현재 폴더 경로 넣기"/>
        </DockPanel>

        <Grid x:Name="PanelGrid" Margin="2"/>
    </DockPanel>
</Window>
