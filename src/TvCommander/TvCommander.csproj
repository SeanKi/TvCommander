<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>TvCommander</AssemblyName>
    <RootNamespace>TvCommander</RootNamespace>
    <Version>0.3.0</Version>
    <Product>TvCommander</Product>
  </PropertyGroup>

  <!-- git 커밋/수정 여부를 어셈블리 메타데이터로 넣는다 (창 제목 표시용) -->
  <Target Name="EmbedGitInfo" BeforeTargets="GetAssemblyAttributes" Condition="Exists('$(MSBuildThisFileDirectory)..\..\.git')">
    <Exec Command="git rev-parse --short HEAD" WorkingDirectory="$(MSBuildThisFileDirectory)" ConsoleToMSBuild="true"
          IgnoreExitCode="true" StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="GitCommit" />
    </Exec>
    <Exec Command="git status --porcelain" WorkingDirectory="$(MSBuildThisFileDirectory)..\.." ConsoleToMSBuild="true"
          IgnoreExitCode="true" StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="GitStatus" />
    </Exec>
    <PropertyGroup>
      <GitDirty>false</GitDirty>
      <GitDirty Condition="'$(GitStatus)' != ''">true</GitDirty>
    </PropertyGroup>
    <ItemGroup>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>GitCommit</_Parameter1>
        <_Parameter2>$(GitCommit)</_Parameter2>
      </AssemblyAttribute>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>GitDirty</_Parameter1>
        <_Parameter2>$(GitDirty)</_Parameter2>
      </AssemblyAttribute>
    </ItemGroup>
  </Target>

  <!-- C++ FmCore.dll 을 출력/배포 폴더에 복사 (build.ps1 또는 솔루션 빌드가 먼저 만든다) -->
  <PropertyGroup>
    <NativeDll>$(MSBuildThisFileDirectory)..\..\build\$(Configuration)\FmCore.dll</NativeDll>
  </PropertyGroup>
  <Target Name="CopyNativeDll" AfterTargets="Build">
    <Error Condition="!Exists('$(NativeDll)')" Text="FmCore.dll not found: $(NativeDll). Run build.ps1 to build the C++ module first." />
    <Copy SourceFiles="$(NativeDll)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="PublishNativeDll" AfterTargets="Publish">
    <Copy SourceFiles="$(NativeDll)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
