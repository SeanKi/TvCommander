<Window x:Class="TvCommander.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TvCommander" Width="1280" Height="800" MinWidth="640" MinHeight="400"
        FontFamily="Segoe UI" FontSize="12">
    <Window.Resources>
        <Style x:Key="Glyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
        </Style>
        <Style x:Key="FnButton" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Margin" Value="1"/>
            <Setter Property="Padding" Value="4,3"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <ToolBarTray DockPanel.Dock="Top" IsLocked="True">
            <ToolBar>
                <ToolBar.Resources>
                    <Style TargetType="Button" BasedOn="{StaticResource {x:Static ToolBar.ButtonStyleKey}}">
                        <Setter Property="Focusable" Value="False"/>
                        <Setter Property="Padding" Value="5,2"/>
                    </Style>
                    <Style TargetType="RadioButton" BasedOn="{StaticResource {x:Static ToolBar.RadioButtonStyleKey}}">
                        <Setter Property="Focusable" Value="False"/>
                        <Setter Property="Padding" Value="7,2"/>
                    </Style>
                    <Style TargetType="ToggleButton" BasedOn="{StaticResource {x:Static ToolBar.ToggleButtonStyleKey}}">
                        <Setter Property="Focusable" Value="False"/>
                        <Setter Property="Padding" Value="5,2"/>
                    </Style>
                </ToolBar.Resources>

                <RadioButton x:Name="Layout2" GroupName="Layout" Tag="2" Click="Layout_Click" Content="2창" ToolTip="2개 패널 (Ctrl+F2)"/>
                <RadioButton x:Name="Layout3" GroupName="Layout" Tag="3" Click="Layout_Click" Content="3창" ToolTip="3개 패널 (Ctrl+F3)"/>
                <RadioButton x:Name="Layout4" GroupName="Layout" Tag="4" Click="Layout_Click" Content="4창" ToolTip="4개 패널, 가로 배치 (Ctrl+F4)"/>
                <RadioButton x:Name="Layout4Grid" GroupName="Layout" Tag="4g" Click="Layout_Click" Content="4창 2×2" ToolTip="4개 패널, 격자 배치"/>
                <Separator/>
                <Button Click="Back_Click" ToolTip="뒤로 (Alt+←)">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE72B;" Margin="0"/>
                </Button>
                <Button Click="Forward_Click" ToolTip="앞으로 (Alt+→)">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE72A;" Margin="0"/>
                </Button>
                <Button Click="Up_Click" ToolTip="상위 폴더 (Backspace)">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE74A;" Margin="0"/>
                </Button>
                <Button Click="Refresh_Click" ToolTip="새로고침 (Ctrl+R)">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE72C;" Margin="0"/>
                </Button>
                <Separator/>
                <Button Click="Search_Click" ToolTip="파일 찾기 (Alt+F7)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE721;"/>
                        <TextBlock Text="파일 찾기"/>
                    </StackPanel>
                </Button>
                <Separator/>
                <Button Click="CopyPath_Click" ToolTip="현재 폴더 경로를 클립보드로 복사">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE8C8;"/>
                        <TextBlock Text="경로 복사"/>
                    </StackPanel>
                </Button>
                <Button Click="CopyFullPaths_Click" ToolTip="선택한 항목의 전체 경로 복사 (Ctrl+Shift+C)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE8C8;"/>
                        <TextBlock Text="전체 경로"/>
                    </StackPanel>
                </Button>
                <Button Click="CopyNames_Click" ToolTip="선택한 항목의 이름 복사">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE8C8;"/>
                        <TextBlock Text="이름"/>
                    </StackPanel>
                </Button>
                <Separator/>
                <Button Click="NewFolder_Click" ToolTip="새 폴더 (F7)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE8F4;"/>
                        <TextBlock Text="새 폴더"/>
                    </StackPanel>
                </Button>
                <Button Click="Terminal_Click" ToolTip="여기서 터미널 열기 (F9)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE756;"/>
                        <TextBlock Text="터미널"/>
                    </StackPanel>
                </Button>
                <Button Click="Swap_Click" ToolTip="패널 경로 교체 (Ctrl+U)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE8AB;"/>
                        <TextBlock Text="교체"/>
                    </StackPanel>
                </Button>
                <ToggleButton x:Name="HiddenToggle" Click="Hidden_Click" ToolTip="숨김 파일 보기 (Ctrl+H)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE890;"/>
                        <TextBlock Text="숨김 파일"/>
                    </StackPanel>
                </ToggleButton>
            </ToolBar>
        </ToolBarTray>

        <UniformGrid DockPanel.Dock="Bottom" Rows="1" Margin="2,0,2,2">
            <Button Style="{StaticResource FnButton}" Tag="F3" Click="FnKey_Click" Content="F3 보기"/>
            <Button Style="{StaticResource FnButton}" Tag="F4" Click="FnKey_Click" Content="F4 편집"/>
            <Button Style="{StaticResource FnButton}" Tag="F5" Click="FnKey_Click" Content="F5 복사"/>
            <Button Style="{StaticResource FnButton}" Tag="F6" Click="FnKey_Click" Content="F6 이동"/>
            <Button Style="{StaticResource FnButton}" Tag="F7" Click="FnKey_Click" Content="F7 새 폴더"/>
            <Button Style="{StaticResource FnButton}" Tag="F8" Click="FnKey_Click" Content="F8 삭제"/>
            <Button Style="{StaticResource FnButton}" Tag="F9" Click="FnKey_Click" Content="F9 터미널"/>
            <Button Style="{StaticResource FnButton}" Tag="F10" Click="FnKey_Click" Content="F10 종료"/>
        </UniformGrid>

        <Grid x:Name="PanelGrid" Margin="2"/>
    </DockPanel>
</Window>
