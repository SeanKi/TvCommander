<Window x:Class="TvCommander.Views.ViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="960" Height="720" WindowStartupLocation="CenterOwner" FontFamily="Segoe UI" FontSize="12">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Padding="6,3" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
            <TextBlock x:Name="InfoText" TextTrimming="CharacterEllipsis"/>
        </Border>
        <Grid>
            <TextBox x:Name="TextView" IsReadOnly="True" IsUndoEnabled="False" BorderThickness="0"
                     FontFamily="Consolas, D2Coding, Malgun Gothic" FontSize="13"
                     HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                     Visibility="Collapsed"/>
            <ScrollViewer x:Name="ImageScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          Visibility="Collapsed" Background="#FF303030">
                <Image x:Name="ImageView" Stretch="Uniform" StretchDirection="DownOnly"/>
            </ScrollViewer>
            <TextBlock x:Name="StateText" Text="불러오는 중..." HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextWrapping="Wrap" Margin="20"/>
        </Grid>
    </DockPanel>
</Window>
