<Project Sdk="Microsoft.NET.Sdk">
  <!-- 먹통 방지 / 열거 성능 점검용 콘솔. 앱의 IO·Model·Native 소스를 그대로 컴파일한다. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\src\TvCommander\GlobalUsings.cs" />
    <Compile Include="..\..\src\TvCommander\IO\*.cs" />
    <Compile Include="..\..\src\TvCommander\Model\*.cs" />
    <Compile Include="..\..\src\TvCommander\Native\*.cs" />
  </ItemGroup>
  <Target Name="CopyNativeDll" AfterTargets="Build">
    <Copy SourceFiles="$(MSBuildThisFileDirectory)..\..\build\Release\FmCore.dll" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
